{
  "version": "2.0.0",
  "options": {
    "env": {
      "PATH": "${env:LOCALAPPDATA}\\MiniAutosarTools\\mingw\\mingw64\\bin;${env:LOCALAPPDATA}\\MiniAutosarTools\\cmake\\bin;${env:PATH}"
    }
  },
  "tasks": [
    {
      "label": "CMake: configure (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", "${workspaceFolder}",
        "-B", "${workspaceFolder}/build",
        "-G", "Ninja",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_C_COMPILER=gcc"
      ],
      "problemMatcher": []
    },
    {
      "label": "CMake: build (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build"],
      "dependsOn": "CMake: configure (Debug)",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "CMake: clean",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build", "--target", "clean"],
      "problemMatcher": []
    },
    {
      "label": "CTest: run self-test",
      "type": "shell",
      "command": "ctest",
      "args": ["--test-dir", "${workspaceFolder}/build", "--output-on-failure"],
      "dependsOn": "CMake: build (Debug)",
      "problemMatcher": []
    },
    {
      "label": "Run: self-test",
      "type": "shell",
      "command": "${workspaceFolder}/build/miniautosar_host.exe",
      "dependsOn": "CMake: build (Debug)",
      "problemMatcher": []
    },
    {
      "label": "Run: self-test (dump simulated Flash)",
      "type": "shell",
      "command": "${workspaceFolder}/build/miniautosar_host.exe",
      "args": ["--dump"],
      "dependsOn": "CMake: build (Debug)",
      "problemMatcher": []
    }
  ]
}

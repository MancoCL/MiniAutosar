{
  "version": 4,
  "configurations": [
    {
      "name": "Win32-MinGW",
      "includePath": [
        "${workspaceFolder}/Codes/Port",
        "${workspaceFolder}/Codes/Config",
        "${workspaceFolder}/Codes/Memory/MiniFlsIf",
        "${workspaceFolder}/Codes/Memory/MiniFee",
        "${workspaceFolder}/Codes/Memory/MiniNvm",
        "${workspaceFolder}/Codes/Test"
      ],
      "defines": [
        "MININVM_TEST_ROT_ROUNDS=240u"
      ],
      "compilerPath": "${env:LOCALAPPDATA}/MiniAutosarTools/mingw/mingw64/bin/gcc.exe",
      "cStandard": "c99",
      "cppStandard": "c++17",
      "intelliSenseMode": "windows-gcc-x64",
      "compileCommands": "${workspaceFolder}/build/compile_commands.json"
    }
  ]
}
